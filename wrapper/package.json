{
  "name": "@jfrz38/nestjs-open-api-generator-wrapper",
  "version": "1.1.9",
  "peerDependencies": {
    "class-validator": ">=0.14.0"
  },
  "description": "Wrapper for OpenAPI Generator that produces a custom, opinionated code structure with predefined templates and configurations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfrz38/nestjs-openapi-generator-wrapper.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nestjs-openapi-wrapper": "./dist/src/bin/generate.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "copyfiles -u 1 src/**/*.mustache dist/src",
    "generate": "node ./dist/src/bin/generate.js",
    "prepare": "npm run build",
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "keywords": [
    "openapi",
    "generator",
    "typescript",
    "nestjs",
    "wrapper"
  ],
  "author": "José F. Ruiz Zamora <jrz899@inlumine.ual.es>",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@openapitools/openapi-generator-cli": "2.40.1",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "copyfiles": "2.4.1",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
